rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Complaints: anyone can create (submit) a complaint and read complaints
    // (needed for the "My Complaints" tracking-ID lookup, which has no login).
    // Only a signed-in admin can edit (change status) or delete.
    match /complaints/{complaintId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // Upcoming projects, completed projects, funds: public read-only.
    // Add/edit these documents yourself from the Firebase Console, or while
    // signed in as admin (only signed-in users can write).
    match /projects_upcoming/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects_done/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /funds/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
