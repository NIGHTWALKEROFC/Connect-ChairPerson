rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Complaints:
    //  - Anyone can CREATE (submit) a complaint.
    //  - GET (fetch one specific complaint by its exact ID/tracking ID) is
    //    public — this is what powers "My Complaints" tracking, with no
    //    login needed. The tracking ID itself is a long random string, so
    //    it acts like a private access code: knowing it lets you read that
    //    one complaint, but it can't be guessed or browsed to.
    //  - LIST (browse/query the whole collection) requires an admin login.
    //    This is the important part: without this line, anyone could call
    //    Firestore directly (bypassing the website entirely) and read every
    //    complaint ever submitted. Restricting LIST to signed-in admins
    //    closes that off completely.
    //  - Only a signed-in admin can UPDATE (change status) or DELETE.
    match /complaints/{complaintId} {
      allow create: if true;
      allow get: if true;
      allow list: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Upcoming projects, completed projects, funds: public read-only.
    // Manage these directly from the admin panel's "Site Content" tab
    // (or from the Firebase Console if you prefer) — either way, only a
    // signed-in admin can add, edit, or delete entries.
    match /projects_upcoming/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects_done/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /funds/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Resolved cases (complaint + the solution the admin recorded for it):
    // public read-only, admin-only write. Same pattern as the three above.
    match /resolved_cases/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Site settings (currently just whether the "Call Chairperson" button
    // is shown). Public read so every visitor's page can check it; only a
    // signed-in admin can change it.
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
